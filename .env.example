# Copy to .env next to docker-compose.yml (compose reads it automatically),
# or place it as /config/.env inside the appdata folder.

# --- general ---------------------------------------------------------------
TZ=Europe/Berlin
LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=text          # text | json
PORT=8080

# --- paths (inside the container; map them with volumes) -------------------
CONFIG_DIR=/config
DOWNLOAD_DIR=/downloads

# --- download manager ------------------------------------------------------
MAX_CONCURRENT_DOWNLOADS=2   # packages downloaded at the same time
PIECE_CONCURRENCY=2          # parallel pieces within one split package
MAX_BANDWIDTH_MBPS=0         # 0 = unlimited, otherwise the total cap in Mbit/s
DOWNLOAD_CHUNK_SIZE=1048576  # bytes per write
VERIFY_HASHES=true           # verify every piece hash (SHA-256/SHA-1)
PREALLOCATE_FILES=true       # sparse-allocate the output file up front

# --- outbound HTTP ---------------------------------------------------------
HTTP_TIMEOUT_SECONDS=60
HTTP_CONNECT_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=6
HTTP_BACKOFF_BASE_SECONDS=2
HTTP_BACKOFF_MAX_SECONDS=60
# HTTP_PROXY_URL=http://proxy:8080
VERIFY_TLS=true

# --- metadata --------------------------------------------------------------
CACHE_TTL_HOURS=6
PROSPERO_BASE_URL=https://prosperopatches.com
# PROSPERO_RULES_FILE=/config/prospero_rules.yaml
# MAX_FIRMWARE=12.60        # empty = show every update

# --- security (all optional, everything is off by default) -----------------
# AUTH_USERNAME=unraid
# AUTH_PASSWORD=change-me
# API_TOKEN=generate-a-long-random-token
# READ_ONLY=false           # true = browsing only, no downloads, no settings
